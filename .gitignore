# never commit archives: sources are downloaded at build time (AGENTS.md)
*.tgz
*.tar
*.tar.gz
*.tar.xz
*.tar.bz2
*.tar.zst
*.zip
*.rpm
*.log

# local scratch
tmp/

# downloaded sources/payloads that are not archives (land next to the spec)
packages/*/COPYING
packages/*/LICENSE*
packages/*/OFL*
packages/*/*.ttf
packages/*/*.otf
packages/*/*.ttc
packages/*/*.woff2
packages/*/cd_on_quit.*
packages/hostapd-wpe/hostapd-wpe-*.patch

# vendoring artifacts (tools/vendor-sources.py)
packages/*/vendor-cargo-config.toml
packages/*/.vendor-ok

# anything extracted or vendored inside a package dir (keep last)
packages/*/*/
__pycache__/

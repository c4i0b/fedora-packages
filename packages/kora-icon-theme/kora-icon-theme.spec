# Ready-made upstream theme dirs (no install.sh): kora/ is the blue-folder
# variant, kora-pgrey/ the grey one via links into ../kora/ — copying both
# keeps a single copy of each icon. Upstream ships a stale icon-theme.cache
# snapshot and a refresh script per theme; caches are generated by the
# gtk-update-icon-cache file trigger, so neither is packaged.
%define debug_package %{nil}

Name:           kora-icon-theme
Version:        2.0.6
Release:        1%{?dist}
Summary:        Kora SVG icon theme

License:        GPL-3.0-only
URL:            https://github.com/bikass/kora
Source0:        https://github.com/bikass/kora/archive/refs/tags/v%{version}.tar.gz

%description
Kora is an SVG icon theme for GNU/Linux, with light and dark variants and
HiDPI support. Two flavors ship here: kora (blue folders) and kora-pgrey
(grey folders), the latter linking back into ../kora/ so lookups work with
both installed.

%prep
%setup -q -n kora-%{version}

%build

%install
rm -f kora/{icon-theme.cache,create-new-icon-theme.cache.sh} \
      kora-pgrey/{icon-theme.cache,create-new-icon-theme.cache.sh}
mkdir -p %{buildroot}%{_datadir}/icons
cp -a kora kora-pgrey %{buildroot}%{_datadir}/icons/

%check
# kora-pgrey is mostly relative links: a dangling target is a dead icon in
# every consumer; also verify both index themes made it through
dangling=$(find %{buildroot}%{_datadir}/icons/kora-pgrey -type l \
  ! -exec test -e {} \; -print | wc -l)
[ "$dangling" -eq 0 ]
test -s %{buildroot}%{_datadir}/icons/kora/index.theme
test -s %{buildroot}%{_datadir}/icons/kora-pgrey/index.theme

%files
%license LICENSE
%{_datadir}/icons/kora*


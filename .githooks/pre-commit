#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
# Runs wherever the rpm toolchain lives: directly inside the tooling
# container (`just shell`), or through podman compose on the host (the host
# only has git + podman).
if command -v rpmspec >/dev/null 2>&1; then
  exec bash "$root/tools/pre-commit.sh" "$@"
fi
exec podman compose -f "$root/compose.yml" run --rm tooling tools/pre-commit.sh "$@"
